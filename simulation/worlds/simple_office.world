      <joint name="table_top_to_leg_1" type="fixed">
        <parent>table_top</parent>
        <child>leg_1</child>
      </joint>
      <joint name="table_top_to_leg_2" type="fixed">
        <parent>table_top</parent>
        <child>leg_2</child>
      </joint>
      <joint name="table_top_to_leg_3" type="fixed">
        <parent>table_top</parent>
