    <!-- Charging station -->
    <model name="charging_station">
      <pose>8 8 0.2 0 0 0</pose>
      <link name="base">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 1.5 0.4</size>
            </box>
