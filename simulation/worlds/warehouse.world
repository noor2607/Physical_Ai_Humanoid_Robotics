        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 1.5 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.6 1 1</ambient>
            <diffuse>0.2 0.6 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Moving obstacle (simulated robot) -->
    <model name="moving_robot">
      <pose>-5 -5 0.2 0 0 0</pose>
      <link name="base_link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.4</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.1</iyy>
            <iyz>0</iyz>
            <izz>0.1</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <!-- Lighting -->
    <light name="warehouse_light_1" type="point">
      <pose>-5 5 5 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <light name="warehouse_light_2" type="point">
      <pose>5 5 5 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
