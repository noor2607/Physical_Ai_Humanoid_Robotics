{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitThis": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "node",
    "baseUrl": "./",
    "paths": {
      "@src/*": ["src/*"],
      "@models/*": ["src/models/*"],
      "@api/*": ["src/api/*"],
      "@controllers/*": ["src/api/controllers/*"],
      "@routes/*": ["src/api/routes/*"],
      "@middleware/*": ["src/api/middleware/*"]
    }
  },
  "include": [
    "src/api/**/*",
    "src/models/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}